{
  "name": "protonium",
  "version": "0.1.0",
  "description": "Unofficial Electron wrapper for mail.proton.me",
  "homepage": "https://github.com/omrxm18/protonium.desktop",
  "author": {
  "name": "omrxm18",
  "email": "omrxm18@proton.me"
  },
  "desktopName": "protonium.desktop",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dir": "npm run dist -- -l dir",
    "prepare-arch": "tar -czvf \"aur/protonium-$npm_package_version.tar.gz\" -C release/linux-unpacked/ .",
    "build-arch": "npm run dir && npm run prepare-arch && cd aur && makepkg -s $MAKEPKG_FLAGS"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "electron": "^41.10.2",
    "electron-builder": "^26.16.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.omrxm18.protonium",
    "productName": "Protonium",
    "directories": { "output": "release" },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "files": ["dist/**", "assets/**"]
  }
}
