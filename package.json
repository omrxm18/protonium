{
  "name": "protonmail-desktop",
  "version": "0.1.0",
  "description": "Unofficial Electron wrapper for mail.proton.me",
  "homepage": "https://github.com/omrxm18/protonmail.desktop",
  "author": "omrxm18 <omrxm18@proton.me>",
  "email": "omrxm18@proton.me",
  "desktopName": "protonmail-dekstop.desktop",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "electron": "^41.10.2",
    "electron-builder": "^26.16.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.omrxm18.protonmail-desktop",
    "productName": "ProtonMail",
    "directories": { "output": "release" },
    "linux": {
      "target": ["AppImage", "deb", "rpm", "pacman", "tar.gz"],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "files": ["dist/**", "assets/**"]
  }
}
